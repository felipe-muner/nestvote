# Copy to .env.local and fill in. Only DATABASE_URL and AUTH_SECRET are required
# to run locally. Without Google OAuth you can browse but not vote.

# Postgres. The docker compose file exposes a local one on port 5433.
DATABASE_URL=postgres://nestvote:nestvote@localhost:5433/nestvote

# Auth.js (NextAuth v5)
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
